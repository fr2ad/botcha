# Copy to .env and fill in as each piece gets configured. Every var here is
# optional — unset, the app behaves exactly as it does today (mocked login,
# no analytics, no push). Vite only exposes vars prefixed VITE_ to the client,
# so nothing else needs one.

# Only needed if the backend isn't same-origin (e.g. local dev against a
# deployed API). Empty means "same origin as the page".
VITE_API_BASE=

# --- Google Sign-In ---------------------------------------------------------
# Same OAuth Client ID as server/.env's GOOGLE_CLIENT_ID (Google Cloud
# Console > APIs & Services > Credentials). This one is safe to ship to the
# browser — it's not a secret, just an identifier Google's SDK reads.
VITE_GOOGLE_CLIENT_ID=

# --- Firebase (analytics + push) --------------------------------------------
# Firebase console > Project Settings > General > Your apps > Web app > SDK
# setup and configuration. All of these are public client config, safe to
# ship — same as GOOGLE_CLIENT_ID above, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase console > Project Settings > Cloud Messaging > Web configuration >
# Web Push certificates > Generate key pair. Needed for enablePushNotifications
# (web/src/firebase.ts) to actually get a token — without it, push silently
# stays off even if the rest of the Firebase config above is filled in.
VITE_FIREBASE_VAPID_KEY=

# public/sw.js can't read these (it's a static file, not built by Vite) — its
# own FIREBASE_CONFIG constant needs the apiKey/authDomain/... values above
# copied in by hand for background push to work when the tab isn't focused.
