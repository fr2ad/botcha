# Copy to .env and fill in for real bot replies. Without OPENROUTER_API_KEY
# the bot uses canned mock replies so the game still runs end to end locally.
PORT=8787
DB_PATH=./botcha.sqlite
OPENROUTER_API_KEY=

# Free-tier model (zero cost). OpenRouter's free catalog is small and shifts
# often — as of Aug 2026 this was one of only 4 models at $0 cost, and the
# only one that isn't code-specialized. It's also brand new with no track
# record yet, so watch bot reply quality/latency in practice. Check
# https://openrouter.ai/models?max_price=0 before relying on this long-term,
# and swap to a paid model (a few cents per game) if quality/uptime matters
# more than $0 cost.
OPENROUTER_MODEL=inclusionai/ling-3.0-tiny:free
