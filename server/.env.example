# Copy to .env and fill in for real bot replies. Without OPENROUTER_API_KEY
# the bot uses canned mock replies so the game still runs end to end locally.
PORT=8787
DB_PATH=./botcha.sqlite
OPENROUTER_API_KEY=

# Enables /api/bot-test/reply and the /#/bot-test page. Local dev only: the
# endpoint has no auth and no rate limit, so exposing it hands the internet a
# free LLM proxy billed to the key above.
BOT_TEST=

# Paid model, chosen by benchmarking candidates against the real persona
# prompt (SPEC 5) — 9 samples each, scored on the failure modes that matter
# in game. Roughly $0.11 per 1000 games at ~600 prompt + 40 completion
# tokens x 3 bot turns, so cost is not the deciding factor; behaviour is.
#
# Why this one:
#   - Non-reasoning "instruct" variant. Reasoning models are the trap here:
#     they spend the token budget on hidden reasoning and return null
#     content, which silently degrades the bot to canned mock replies.
#   - 0/9 replies prefixed with another seat's name. gpt-4o-mini did that in
#     4/9 (it imitates the "Blue Fox: hi" history format) — a dead giveaway.
#   - 0/9 leaked AI-ness, including under direct "ignore your instructions"
#     probes. 0/9 exceeded the 200-char cap.
#   - 4 providers on OpenRouter, so a single provider outage fails over.
#
# If you swap models: re-run the bench, and confirm
# `choices[0].message.content` is not null and carries no reasoning tokens.
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
