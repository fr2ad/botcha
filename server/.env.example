# Copy to .env and fill in for real bot replies. Without OPENROUTER_API_KEY
# the bot uses canned mock replies so the game still runs end to end locally.
PORT=8787
DB_PATH=./botcha.sqlite
OPENROUTER_API_KEY=

# Free-tier model (zero cost). Verified working as of Aug 2026: reasoning
# tokens stay small enough to leave room for actual content within
# max_tokens (client.ts's getBotReply). inclusionai/ling-3.0-tiny:free was
# tried first and rejected — it burns the entire token budget on hidden
# "reasoning" and never emits content, so the bot silently fell back to
# canned mock replies on every single turn. If you swap models, sanity-check
# with a raw curl to openrouter.ai/api/v1/chat/completions first and confirm
# `choices[0].message.content` isn't null. Check
# https://openrouter.ai/models?max_price=0 for the current free catalog.
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
